# SEC requires a meaningful User-Agent with contact information for production requests.
SEC_FILING_AGENT_SEC_USER_AGENT="Your Company contact@example.com"

# The service binds to loopback by default, so it is only reachable from this machine.
SEC_FILING_AGENT_HOST=127.0.0.1
SEC_FILING_AGENT_PORT=8000
SEC_FILING_AGENT_DATA_DIR=./data
