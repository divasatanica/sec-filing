# The service binds to loopback by default, so it is only reachable from this machine.
SEC_FILING_AGENT_SEC_USER_AGENT=sec-filing-agent/0.1 contact@example.com
SEC_FILING_AGENT_HOST=127.0.0.1
SEC_FILING_AGENT_PORT=8000
# Defaults to readable terminal logs in development and JSON logs elsewhere.
# SEC_FILING_AGENT_LOG_JSON=true
# SEC_FILING_AGENT_LOG_LEVEL=INFO
